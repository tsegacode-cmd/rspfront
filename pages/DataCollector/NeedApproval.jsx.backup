import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'
import { dataRegistrationAPI, userAPI } from '../../services/api'
import { getIconVisibility } from '../../utils/permissions'
import { usePermissions } from '../../hooks/usePermissions'
import * as XLSX from 'xlsx'
import jsPDF from 'jspdf'
import 'jspdf-autotable'
import './NeedApproval.css'

// Helper function to safely format dates
const formatDate = (dateString) => {
  if (!dateString) return 'N/A'
  
  try {
    const date = new Date(dateString)
    // Check if date is valid
    if (isNaN(date.getTime())) {
      return 'N/A'
    }
    return date.toLocaleDateString()
  } catch (error) {
    return 'N/A'
  }
}

// Helper function to safely get registration ID (MongoDB compatible)
const getRegistrationId = (registration) => {
  console.log('🔍 GET REGISTRATION ID');
  console.log('Registration object:', registration);
  
  let id = null;
  
  // Handle MongoDB ObjectId format
  if (registration._id) {
    id = registration._id;
    console.log('Found _id:', id, 'Type:', typeof id);
  }
  // Handle regular id format
  else if (registration.id) {
    id = registration.id;
    console.log('Found id:', id, 'Type:', typeof id);
  }
  
  // If id is an object, convert to string
  if (id && typeof id === 'object') {
    if (id.$oid) {
      // MongoDB extended JSON format
      id = id.$oid;
      console.log('Extracted $oid:', id);
    } else if (id.toString) {
      id = id.toString();
      console.log('Converted object to string:', id);
    }
  }
  
  // Convert to string and trim
  if (id) {
    id = String(id).trim();
    console.log('Final ID:', id, 'Length:', id.length);
  } else {
    console.error('❌ NO ID FOUND IN REGISTRATION');
  }
  
  return id;
}

function NeedApproval() {
  const navigate = useNavigate()
  const [registrations, setRegistrations] = useState([])
  const [filteredRegistrations, setFilteredRegistrations] = useState([])
  const [staffList, setStaffList] = useState([])
  const [loading, setLoading] = useState(true)
  const [notification, setNotification] = useState(null)
  const [showApproveModal, setShowApproveModal] = useState(false)
  const [selectedRegistration, setSelectedRegistration] = useState(null)
  const [selectedStaffForApproval, setSelectedStaffForApproval] = useState('')
  
  // Inline editing states
  const [editingRowId, setEditingRowId] = useState(null)
  const [tempStaffSelection, setTempStaffSelection] = useState({})
  
  // Filter states
  const [selectedKebele, setSelectedKebele] = useState('')
  const [selectedUnpaidReg, setSelectedUnpaidReg] = useState('')
  const [selectedWorkType, setSelectedWorkType] = useState('')
  const [selectedStaff, setSelectedStaff] = useState('')
  
  // Pagination states
  const [currentPage, setCurrentPage] = useState(1)
  const itemsPerPage = 25
  
  // Search state for sidebar
  const [searchQuery, setSearchQuery] = useState('')
  
  // Period filter states
  const [periodFilter, setPeriodFilter] = useState('all')
  const [customStartDate, setCustomStartDate] = useState('')
  const [customEndDate, setCustomEndDate] = useState('')
  
  // Edit modal states
  const [showEditModal, setShowEditModal] = useState(false)
  const [editingRegistration, setEditingRegistration] = useState(null)
  
  // Use permission polling hook
  const { permissions } = usePermissions(true, 30000)
  
  // Permission states (derived from permissions hook)
  const editIconVisibility = permissions.icons?.editIcon || 'visible'
  const deleteIconVisibility = permissions.icons?.deleteIcon || 'visible'
  
  const [editFormData, setEditFormData] = useState({
    work_type: '',
    staff_id: '',
    staff_username: '',
    staff_full_name: '',
    client_name: '',
    kebele: '',
    house_no: '',
    client_phone: '',
    tv_no: '1',
    person: 'personal',
    client_email: '',
    condition: 'new',
    sign: 'sign',
    gov_letter: 'accept',
    paid_amount: '',
    payment_status: 'unpaid'
  })

  // Helper function to safely extract ID as string
  const getRegistrationId = (registration) => {
    if (!registration) return null
    
    // Handle MongoDB ObjectId
    if (registration._id) {
      if (typeof registration._id === 'object' && registration._id.$oid) {
        return registration._id.$oid
      }
      return String(registration._id)
    }
    
    // Handle regular ID
    if (registration.id) {
      return String(registration.id)
    }
    
    return null
  }

  useEffect(() => {
    loadData()
  }, [])

  useEffect(() => {
    applyFilters()
  }, [registrations, selectedKebele, selectedWorkType, selectedStaff, periodFilter, customStartDate, customEndDate, searchQuery])

  const loadData = async () => {
    console.log('🔄 Loading Need Approval data...')
    setLoading(true)
    
    try {
      console.log('📡 Making API calls...')
      console.log('🌐 API URL:', import.meta.env.VITE_API_URL || 'http://localhost:5000/api/v1')
      
      const [regResponse, staffResponse] = await Promise.all([
        dataRegistrationAPI.getAllRegistrations(),
        userAPI.getAllUsers()
      ])
      
      console.log('📊 Registration Response:', regResponse)
      console.log('👥 Staff Response:', staffResponse)
      
      if (regResponse.success) {
        console.log('✅ Registration data received:', regResponse.data.length, 'total registrations')
        console.log('📋 All registrations:', regResponse.data)
        
        // Show all staff usernames found
        const staffUsernames = [...new Set(regResponse.data.map(r => r.staff_username))];
        console.log('� Staff usernames found:', staffUsernames)
        
        // Filter only registrations with staff_username = "UNAPPROVED STAFF"
        const unapprovedRegs = regResponse.data.filter(
          reg => reg.staff_username === 'UNAPPROVED STAFF'
        )
        
        console.log('🔍 Filtered UNAPPROVED STAFF registrations:', unapprovedRegs.length)
        console.log('📋 UNAPPROVED STAFF registrations:', unapprovedRegs)
        
        // TEMPORARY: If no UNAPPROVED STAFF found, show all registrations for debugging
        if (unapprovedRegs.length === 0) {
          console.log('⚠️ No UNAPPROVED STAFF found, showing all registrations for debugging')
          setRegistrations(regResponse.data)
          setFilteredRegistrations(regResponse.data)
        } else {
          setRegistrations(unapprovedRegs)
          setFilteredRegistrations(unapprovedRegs)
        }
      } else {
        console.error('❌ Failed to load registrations:', regResponse.message)
        showNotification('Failed to load registrations: ' + regResponse.message, 'error')
      }
      
      if (staffResponse.success) {
        console.log('✅ Staff data received:', staffResponse.data.length, 'staff members')
        setStaffList(staffResponse.data)
      } else {
        console.error('❌ Failed to load staff:', staffResponse.message)
        showNotification('Failed to load staff: ' + staffResponse.message, 'error')
      }
    } catch (error) {
      console.error('❌ Failed to load data:', error)
      showNotification('Failed to load data: ' + error.message, 'error')
    } finally {
      console.log('✅ Loading complete')
      setLoading(false)
    }
  }

  const applyFilters = () => {
    let filtered = [...registrations]

    // Enhanced search filter - search by all methods/fields
    if (searchQuery) {
      const query = searchQuery.toLowerCase()
      filtered = filtered.filter(reg =>
        // Basic client information
        reg.client_name?.toLowerCase().includes(query) ||
        reg.client_phone?.toLowerCase().includes(query) ||
        reg.client_email?.toLowerCase().includes(query) ||
        
        // Location information
        reg.kebele?.toLowerCase().includes(query) ||
        reg.house_no?.toLowerCase().includes(query) ||
        reg.city?.toLowerCase().includes(query) ||
        
        // Staff information
        reg.staff_username?.toLowerCase().includes(query) ||
        reg.staff_full_name?.toLowerCase().includes(query) ||
        
        // Work and registration details
        reg.work_type?.toLowerCase().includes(query) ||
        reg.person?.toLowerCase().includes(query) ||
        reg.condition?.toLowerCase().includes(query) ||
        reg.sign?.toLowerCase().includes(query) ||
        reg.gov_letter?.toLowerCase().includes(query) ||
        
        // Payment information
        reg.payment_status?.toLowerCase().includes(query) ||
        reg.paid_amount?.toString().includes(query) ||
        reg.collected_amount?.toString().includes(query) ||
        reg.commission_fee?.toString().includes(query) ||
        reg.commission_total?.toString().includes(query) ||
        
        // TV and receipt information
        reg.tv_no?.toString().includes(query) ||
        reg.receipt_no?.toLowerCase().includes(query) ||
        
        // Date information
        reg.registered_at?.toLowerCase().includes(query) ||
        reg.created_at?.toLowerCase().includes(query) ||
        reg.registration_datetime?.toLowerCase().includes(query) ||
        
        // Payment period information
        reg.payment_period_type?.toLowerCase().includes(query) ||
        reg.payment_period_from?.toString().includes(query) ||
        reg.payment_period_to?.toString().includes(query)
      )
    }

    // Filter by Kebele
    if (selectedKebele && selectedKebele !== 'all') {
      filtered = filtered.filter(reg => 
        reg.kebele?.toLowerCase() === selectedKebele.toLowerCase()
      )
    }

    // Filter by Work Type
    if (selectedWorkType) {
      filtered = filtered.filter(reg => reg.work_type === selectedWorkType)
    }

    // Filter by Staff (though all should be UNAPPROVED STAFF)
    if (selectedStaff && selectedStaff !== 'UNAPPROVED STAFF') {
      filtered = filtered.filter(reg => reg.staff_username === selectedStaff)
    }
    
    // Filter by Period
    if (periodFilter !== 'all') {
      const now = new Date()
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
      
      filtered = filtered.filter(reg => {
        const regDate = new Date(reg.created_at || reg.registered_at)
        
        switch (periodFilter) {
          case 'today':
            return regDate >= today
          case 'thisweek': {
            const weekStart = new Date(today)
            weekStart.setDate(today.getDate() - today.getDay())
            return regDate >= weekStart
          }
          case 'lastweek': {
            const lastWeekStart = new Date(today)
            lastWeekStart.setDate(today.getDate() - today.getDay() - 7)
            const lastWeekEnd = new Date(lastWeekStart)
            lastWeekEnd.setDate(lastWeekStart.getDate() + 7)
            return regDate >= lastWeekStart && regDate < lastWeekEnd
          }
          case 'last10days': {
            const tenDaysAgo = new Date(today)
            tenDaysAgo.setDate(today.getDate() - 10)
            return regDate >= tenDaysAgo
          }
          case 'thismonth': {
            const monthStart = new Date(now.getFullYear(), now.getMonth(), 1)
            return regDate >= monthStart
          }
          case 'lastmonth': {
            const lastMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1)
            const lastMonthEnd = new Date(now.getFullYear(), now.getMonth(), 1)
            return regDate >= lastMonthStart && regDate < lastMonthEnd
          }
          case 'yearly': {
            const yearStart = new Date(now.getFullYear(), 0, 1)
            return regDate >= yearStart
          }
          case 'custom': {
            if (customStartDate && customEndDate) {
              const start = new Date(customStartDate)
              const end = new Date(customEndDate)
              end.setHours(23, 59, 59, 999)
              return regDate >= start && regDate <= end
            }
            return true
          }
          default:
            return true
        }
      })
    }

    setFilteredRegistrations(filtered)
    setCurrentPage(1) // Reset to first page when filters change
  }

  const handleDoneClick = (registration) => {
    const regId = getRegistrationId(registration)
    if (!regId) {
      showNotification('Invalid registration ID', 'error')
      return
    }
    setEditingRowId(regId)
    setTempStaffSelection({
      ...tempStaffSelection,
      [regId]: ''
    })
  }

  const handleStaffSelectChange = (registrationId, staffId) => {
    setTempStaffSelection({
      ...tempStaffSelection,
      [registrationId]: staffId
    })
  }

  const handleInlineApprove = async (registration) => {
    const regId = getRegistrationId(registration)
    
    if (!regId) {
      showNotification('Invalid registration ID', 'error')
      return
    }
    
    const selectedStaffId = tempStaffSelection[regId]
    
    if (!selectedStaffId) {
      showNotification('Please select a staff member', 'error')
      return
    }

    try {
      const selectedStaffInfo = staffList.find(
        staff => String(staff.id) === String(selectedStaffId)
      )

      if (!selectedStaffInfo) {
        showNotification('Invalid staff selection', 'error')
        return
      }

      const updateData = {
        staff_id: parseInt(selectedStaffInfo.id) || selectedStaffInfo.id,
        staff_username: selectedStaffInfo.username,
        staff_full_name: selectedStaffInfo.full_name || 'N/A'
      }

      console.log('🔧 Approving registration')
      console.log('Registration ID:', regId)
      console.log('Registration ID type:', typeof regId)
      console.log('Update data:', updateData)

      const response = await dataRegistrationAPI.updateRegistration(
        regId,
        updateData
      )

      if (response.success) {
        showNotification('✓ Registration approved successfully!', 'success')
        setEditingRowId(null)
        setTempStaffSelection({})
        
        // Reload data to refresh the list
        await loadData()
      } else {
        showNotification(response.message || 'Failed to approve registration', 'error')
      }
    } catch (error) {
      console.error('Failed to approve registration:', error)
      showNotification(error.message || 'Failed to approve registration', 'error')
    }
  }

  const handleApproveClick = (registration) => {
    setSelectedRegistration(registration)
    setSelectedStaffForApproval('')
    setShowApproveModal(true)
  }

  const handleApproveSubmit = async () => {
    if (!selectedStaffForApproval) {
      showNotification('Please select a staff member', 'error')
      return
    }

    const regId = getRegistrationId(selectedRegistration)
    
    if (!regId) {
      showNotification('Invalid registration ID', 'error')
      return
    }

    try {
      const selectedStaffInfo = staffList.find(
        staff => String(staff.id) === String(selectedStaffForApproval)
      )

      if (!selectedStaffInfo) {
        showNotification('Invalid staff selection', 'error')
        return
      }

      const updateData = {
        staff_id: parseInt(selectedStaffInfo.id) || selectedStaffInfo.id,
        staff_username: selectedStaffInfo.username,
        staff_full_name: selectedStaffInfo.full_name || 'N/A'
      }

      console.log('🔧 Approving registration (modal)')
      console.log('Registration ID:', regId)
      console.log('Registration ID type:', typeof regId)
      console.log('Update data:', updateData)

      const response = await dataRegistrationAPI.updateRegistration(
        regId,
        updateData
      )

      if (response.success) {
        showNotification('✓ Registration approved successfully!', 'success')
        setShowApproveModal(false)
        setSelectedRegistration(null)
        setSelectedStaffForApproval('')
        
        // Reload data to refresh the list
        await loadData()
      } else {
        showNotification(response.message || 'Failed to approve registration', 'error')
      }
    } catch (error) {
      console.error('Failed to approve registration:', error)
      showNotification(error.message || 'Failed to approve registration', 'error')
    }
  }

  const handleEditClick = (registration) => {
    setEditingRegistration(registration)
    setEditFormData({
      work_type: registration.work_type,
      staff_id: registration.staff_id || '',
      staff_username: registration.staff_username,
      staff_full_name: registration.staff_full_name || '',
      client_name: registration.client_name,
      kebele: registration.kebele,
      house_no: registration.house_no || '',
      client_phone: registration.client_phone,
      tv_no: registration.tv_no,
      person: registration.person,
      client_email: registration.client_email || '',
      condition: registration.condition,
      sign: registration.sign,
      gov_letter: registration.gov_letter || 'accept',
      paid_amount: registration.paid_amount || '',
      payment_status: registration.payment_status
    })
    setShowEditModal(true)
  }

  const handleCloseEditModal = () => {
    setShowEditModal(false)
    setEditingRegistration(null)
  }

  const handleEditInputChange = (e) => {
    const { name, value } = e.target
    
    // If staff is being changed, update staff info
    if (name === 'staff_id') {
      const selectedStaff = staffList.find(s => s.id.toString() === value)
      if (selectedStaff) {
        setEditFormData({
          ...editFormData,
          staff_id: selectedStaff.id,
          staff_username: selectedStaff.username,
          staff_full_name: selectedStaff.full_name || ''
        })
      } else if (value === 'unapproved') {
        setEditFormData({
          ...editFormData,
          staff_id: null,
          staff_username: 'UNAPPROVED STAFF',
          staff_full_name: 'UNAPPROVED STAFF'
        })
      } else if (value === 'other') {
        setEditFormData({
          ...editFormData,
          staff_id: null,
          staff_username: 'Other',
          staff_full_name: 'Other'
        })
      } else if (value === 'all') {
        setEditFormData({
          ...editFormData,
          staff_id: null,
          staff_username: 'All',
          staff_full_name: 'All'
        })
      }
    } else {
      setEditFormData({
        ...editFormData,
        [name]: value
      })
    }
  }

  const handleUpdateRegistration = async (e) => {
    e.preventDefault()
    
    const regId = getRegistrationId(editingRegistration)
    
    if (!regId) {
      showNotification('Invalid registration ID', 'error')
      return
    }
    
    try {
      const updateData = {
        work_type: editFormData.work_type,
        staff_id: editFormData.staff_id || null,
        staff_username: editFormData.staff_username,
        staff_full_name: editFormData.staff_full_name || null,
        client_name: editFormData.client_name,
        kebele: editFormData.kebele,
        house_no: editFormData.house_no || null,
        client_phone: editFormData.client_phone,
        tv_no: editFormData.tv_no,
        person: editFormData.person,
        client_email: editFormData.client_email || null,
        condition: editFormData.condition,
        sign: editFormData.sign,
        gov_letter: editFormData.gov_letter,
        paid_amount: editFormData.paid_amount ? parseFloat(editFormData.paid_amount) : null,
        payment_status: editFormData.payment_status
      }

      const response = await dataRegistrationAPI.updateRegistration(regId, updateData)
      
      if (response.success) {
        showNotification('✓ Registration updated successfully!', 'success')
        handleCloseEditModal()
        
        // Reload to get fresh data
        await loadData()
      }
    } catch (error) {
      console.error('Failed to update registration:', error)
      showNotification(error.message || 'Failed to update registration', 'error')
    }
  }

  const handleDeleteClick = async (registration) => {
    const regId = getRegistrationId(registration)
    
    if (!regId) {
      showNotification('Invalid registration ID', 'error')
      return
    }
    
    if (window.confirm(`Are you sure you want to delete registration for ${registration.client_name}?`)) {
      try {
        const response = await dataRegistrationAPI.deleteRegistration(regId)
        
        if (response.success) {
          showNotification('🗑️ Registration deleted successfully!', 'success')
          
          // Reload data to refresh the list
          await loadData()
        }
      } catch (error) {
        console.error('Failed to delete registration:', error)
        showNotification(error.message || 'Failed to delete registration', 'error')
      }
    }
  }

  const showNotification = (message, type = 'success') => {
    setNotification({ message, type })
    setTimeout(() => setNotification(null), 3000)
  }

  const downloadExcel = () => {
    const worksheet = XLSX.utils.json_to_sheet(
      filteredRegistrations.map((reg, index) => ({
        '#': index + 1,
        'Staff Name': reg.staff_username || 'N/A',
        'Full Name': reg.staff_full_name || 'N/A',
        'Work Type': reg.work_type,
        'Client Name': reg.client_name,
        'Kebele': reg.kebele,
        'House No': reg.house_no || 'N/A',
        'Phone': reg.client_phone,
        'TV No': reg.tv_no,
        'Person': reg.person,
        'Email': reg.client_email || 'N/A',
        'Condition': reg.condition,
        'Sign': reg.sign,
        'Gov Letter': reg.gov_letter || 'N/A',
        'Paid Amount': reg.paid_amount ? `${reg.paid_amount} Birr` : 'N/A',
        'Registered': formatDate(reg.registered_at)
      }))
    )
    const workbook = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(workbook, worksheet, 'Need Approval')
    XLSX.writeFile(workbook, 'Need_Approval.xlsx')
    showNotification('✓ Excel file downloaded!', 'success')
  }

  const downloadPDF = () => {
    const doc = new jsPDF({ orientation: 'landscape' })
    
    // Add logo and header
    doc.setFontSize(18)
    doc.setTextColor(196, 30, 58)
    doc.text('REDSEA', 14, 15)
    
    doc.setFontSize(10)
    doc.setTextColor(100, 100, 100)
    doc.text('fixed and movable Commission Work & Brokerage Services', 14, 22)
    
    doc.setFontSize(14)
    doc.setTextColor(0, 0, 0)
    doc.text('Need Approval - Pending Staff Assignment', 14, 32)
    
    const tableData = filteredRegistrations.map((reg, index) => [
      index + 1,
      reg.staff_username || 'N/A',
      reg.staff_full_name || 'N/A',
      reg.work_type,
      reg.client_name,
      reg.kebele,
      reg.house_no || 'N/A',
      reg.client_phone,
      reg.tv_no,
      reg.person,
      reg.client_email || 'N/A',
      reg.condition,
      reg.sign,
      reg.gov_letter || 'N/A',
      reg.paid_amount ? `${reg.paid_amount} Birr` : 'N/A',
      formatDate(reg.registered_at)
    ])
    
    doc.autoTable({
      startY: 38,
      head: [['#', 'Staff', 'Full Name', 'Work Type', 'Client', 'Kebele', 'House', 'Phone', 'TV', 'Person', 'Email', 'Condition', 'Sign', 'Gov Letter', 'Payment', 'Date']],
      body: tableData,
      styles: { fontSize: 6, cellPadding: 2 },
      headStyles: { fillColor: [196, 30, 58], textColor: [255, 255, 255] },
      alternateRowStyles: { fillColor: [245, 245, 245] },
      margin: { top: 38 }
    })
    
    doc.save('Need_Approval.pdf')
    showNotification('✓ PDF file downloaded!', 'success')
  }

  const handlePrint = () => {
    window.print()
    showNotification('✓ Print dialog opened!', 'success')
  }

  return (
    <div className="need-approval-page">
      <div className="page-layout">
        {/* Left Sidebar - Filters */}
        <div className="left-sidebar">
          <div className="sidebar-header">
            <h3>Filters</h3>
            <div className="results-count">
              <span className="count-badge">{filteredRegistrations.length}</span>
              <span className="count-text">registrations</span>
            </div>
          </div>
          
          {/* Search Box */}
          <div className="sidebar-search">
            <input
              type="text"
              placeholder="🔍 Search by name, phone, kebele, staff, work type, amount, TV, receipt, date..."
              value={searchQuery}
              onChange={(e) => {
                setSearchQuery(e.target.value)
                setCurrentPage(1) // Reset to first page on search
              }}
              className="sidebar-search-input"
            />
          </div>
          
          {/* Period Filter */}
          <div className="sidebar-filter">
            <label>📅 Period Filter</label>
            <select
              value={periodFilter}
              onChange={(e) => {
                setPeriodFilter(e.target.value)
                setCurrentPage(1)
              }}
              className="sidebar-filter-select"
            >
              <option value="all">All Time</option>
              <option value="today">Today</option>
              <option value="thisweek">This Week</option>
              <option value="lastweek">Last Week</option>
              <option value="last10days">Last 10 Days</option>
              <option value="thismonth">This Month</option>
              <option value="lastmonth">Last Month</option>
              <option value="yearly">This Year</option>
              <option value="custom">Custom Range</option>
            </select>
            
            {periodFilter === 'custom' && (
              <div className="sidebar-custom-dates">
                <input
                  type="date"
                  value={customStartDate}
                  onChange={(e) => setCustomStartDate(e.target.value)}
                  className="sidebar-date-input"
                  placeholder="Start Date"
                />
                <input
                  type="date"
                  value={customEndDate}
                  onChange={(e) => setCustomEndDate(e.target.value)}
                  className="sidebar-date-input"
                  placeholder="End Date"
                />
              </div>
            )}
          </div>
          
          {/* Kebele Filter */}
          <div className="sidebar-filter">
            <label>📍 Kebele Filter</label>
            <select
              value={selectedKebele}
              onChange={(e) => {
                setSelectedKebele(e.target.value)
                setCurrentPage(1)
              }}
              className="sidebar-filter-select"
            >
              <option value="">All Woreda</option>
              <option value="01">01</option>
              <option value="02">02</option>
              <option value="03">03</option>
              <option value="04">04</option>
              <option value="05">05</option>
              <option value="06">06</option>
              <option value="07">07</option>
              <option value="08">08</option>
              <option value="09">09</option>
              <option value="10">10</option>
              <option value="11">11</option>
              <option value="12">12</option>
              <option value="13">13</option>
              <option value="14">14</option>
              <option value="15">15</option>
              <option value="16">16</option>
              <option value="17">17</option>
              <option value="18">18</option>
              <option value="19">19</option>
              <option value="sofi gm">Sofi GM</option>
              <option value="dire t gm">Dire T GM</option>
              <option value="erorr">Erorr</option>
            </select>
          </div>

          {/* Work Type Filter */}
          <div className="sidebar-filter">
            <label>📋 Work Type</label>
            <select
              value={selectedWorkType}
              onChange={(e) => {
                setSelectedWorkType(e.target.value)
                setCurrentPage(1)
              }}
              className="sidebar-filter-select"
            >
              <option value="">All Work Types</option>
              <option value="redsea-ebc">REDSEA with EBC Work</option>
              <option value="sells-product">Sells Product Work</option>
              <option value="other">Other</option>
            </select>
          </div>

          {/* Staff Filter */}
          <div className="sidebar-filter">
            <label>👤 Staff Filter</label>
            <select
              value={selectedStaff}
              onChange={(e) => {
                setSelectedStaff(e.target.value)
                setCurrentPage(1)
              }}
              className="sidebar-filter-select"
            >
              <option value="">All Staff</option>
              {staffList.map(staff => (
                <option key={staff.id} value={staff.username}>
                  {staff.username} - {staff.full_name || 'N/A'}
                </option>
              ))}
              <option value="other">Other</option>
              <option value="all">All</option>
            </select>
          </div>
          
          {/* Clear Filters Button */}
          <div className="sidebar-actions">
            <button
              className="btn-clear-filters"
              onClick={() => {
                setSearchQuery('')
                setPeriodFilter('all')
                setCustomStartDate('')
                setCustomEndDate('')
                setSelectedKebele('')
                setSelectedWorkType('')
                setSelectedStaff('')
                setCurrentPage(1)
              }}
            >
              🗑️ Clear All Filters
            </button>
          </div>
        </div>

        {/* Main Content */}
        <div className="main-content">
          {/* Header Section */}
          <div className="need-approval-header">
            <div className="header-content">
              <h1 className="page-title">Need Approval</h1>
              <p className="page-subtitle">Registrations Pending Staff Assignment</p>
            </div>
            <div className="header-buttons">
              <button className="btn-download btn-excel" onClick={downloadExcel}>
                <span className="btn-icon">📊</span>
                <span className="btn-text">Excel</span>
              </button>
              <button className="btn-download btn-pdf" onClick={downloadPDF}>
                <span className="btn-icon">📄</span>
                <span className="btn-text">PDF</span>
              </button>
              <button className="btn-download btn-print" onClick={handlePrint}>
                <span className="btn-icon">🖨️</span>
                <span className="btn-text">Print</span>
              </button>
              <button className="btn-unpaid" onClick={() => navigate('/unpaid')}>
                <span className="btn-icon">📋</span>
                <span className="btn-text">Unpaid</span>
              </button>
              <button className="btn-paid" onClick={() => navigate('/paid')}>
                <span className="btn-icon">💰</span>
                <span className="btn-text">Paid</span>
              </button>
            </div>
          </div>

          {/* Body Section - Registration List */}
          {loading ? (
            <div className="loading-state">
              <div className="spinner"></div>
              <p>Loading UNAPPROVED STAFF registrations...</p>
              <small>Searching for registrations that need staff assignment</small>
            </div>
          ) : filteredRegistrations.length === 0 ? (
            <div className="empty-state">
              <span className="empty-icon">📋</span>
              <h3>No UNAPPROVED STAFF Registrations Found</h3>
              <p>There are currently no registrations with "UNAPPROVED STAFF" status.</p>
              <div className="empty-state-actions">
                <button 
                  className="btn-refresh" 
                  onClick={() => {
                    console.log('🔄 Manual refresh triggered')
                    loadData()
                  }}
                >
                  🔄 Refresh Data
                </button>
                <button 
                  className="btn-debug" 
                  onClick={() => {
                    console.log('🐛 Debug info:')
                    console.log('Total registrations loaded:', registrations.length)
                    console.log('All registrations:', registrations)
                    console.log('Staff usernames found:', [...new Set(registrations.map(r => r.staff_username))])
                  }}
                >
                  🐛 Debug Info
                </button>
              </div>
            </div>
          ) : (
            <>
              <div className="table-container">
                <table className="registrations-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Status</th>
                      <th>Staff Name</th>
                      <th>Full Name</th>
                      <th>Work Type</th>
                      <th>Client Name</th>
                      <th>Kebele</th>
                      <th>House No</th>
                      <th>Phone</th>
                      <th>TV No</th>
                      <th>Person</th>
                      <th>Email</th>
                      <th>Condition</th>
                      <th>Sign</th>
                      <th>Paid Amount</th>
                      <th>Registered</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filteredRegistrations
                      .slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage)
                      .map((registration, index) => {
                      const globalIndex = (currentPage - 1) * itemsPerPage + index
                      const regId = getRegistrationId(registration)
                      const isEditing = editingRowId === regId
                      const selectedStaffId = tempStaffSelection[regId]
                      const selectedStaffInfo = selectedStaffId 
                        ? staffList.find(s => s.id.toString() === selectedStaffId)
                        : null

                      return (
                        <tr key={regId}>
                          <td>{globalIndex + 1}</td>
                          <td>
                            <span className="need-approval-badge">NEED APPROVAL</span>
                          </td>
                          <td>
                            {isEditing && selectedStaffInfo 
                              ? selectedStaffInfo.username 
                              : registration.staff_username || 'N/A'}
                          </td>
                          <td>
                            {isEditing && selectedStaffInfo 
                              ? selectedStaffInfo.full_name || 'N/A'
                              : registration.staff_full_name || 'N/A'}
                          </td>
                          <td>
                            <span className="badge-work">{registration.work_type}</span>
                          </td>
                          <td>{registration.client_name}</td>
                          <td>{registration.kebele}</td>
                          <td>{registration.house_no || 'N/A'}</td>
                          <td>
                            <a href={`tel:${registration.client_phone}`} className="phone-link">
                              {registration.client_phone}
                            </a>
                          </td>
                          <td>
                            <span className="badge-tv">{registration.tv_no} TV</span>
                          </td>
                          <td>{registration.person}</td>
                          <td>{registration.client_email || 'N/A'}</td>
                          <td>
                            <span className="badge-condition">{registration.condition}</span>
                          </td>
                          <td>
                            <span className={`badge-sign ${registration.sign === 'sign' ? 'signed' : 'unsigned'}`}>
                              {registration.sign}
                            </span>
                          </td>
                          <td>
                            {registration.paid_amount ? (
                              <span className="badge-amount">
                                {registration.paid_amount} Birr
                              </span>
                            ) : (
                              <span className="badge-no-amount">N/A</span>
                            )}
                          </td>
                          <td>{formatDate(registration.registered_at)}</td>
                          <td>
                            <div className="action-buttons">
                              {isEditing ? (
                                <>
                                  <select
                                    className="inline-staff-select"
                                    value={selectedStaffId || ''}
                                    onChange={(e) => handleStaffSelectChange(regId, e.target.value)}
                                  >
                                    <option value="">-- Select Staff --</option>
                                    {staffList.map(staff => (
                                      <option key={staff.id} value={staff.id}>
                                        {staff.username} - {staff.full_name || 'N/A'}
                                      </option>
                                    ))}
                                  </select>
                                  <button 
                                    className="btn-action btn-approve" 
                                    title="Approve"
                                    onClick={() => handleInlineApprove(registration)}
                                    disabled={!selectedStaffId}
                                  >
                                    Approve
                                  </button>
                                </>
                              ) : (
                                <>
                                  <button 
                                    className="btn-action btn-done" 
                                    title="Done"
                                    onClick={() => handleDoneClick(registration)}
                                  >
                                    Done
                                  </button>
                                  {editIconVisibility !== 'invisible' && (
                                    <button 
                                      className="btn-action btn-edit" 
                                      title="Edit"
                                      onClick={() => handleEditClick(registration)}
                                      disabled={editIconVisibility === 'disabled'}
                                      style={editIconVisibility === 'disabled' ? { opacity: 0.5, cursor: 'not-allowed' } : {}}
                                    >
                                      ✏️
                                    </button>
                                  )}
                                  {deleteIconVisibility !== 'invisible' && (
                                    <button 
                                      className="btn-action btn-delete" 
                                      title="Delete"
                                      onClick={() => handleDeleteClick(registration)}
                                      disabled={deleteIconVisibility === 'disabled'}
                                      style={deleteIconVisibility === 'disabled' ? { opacity: 0.5, cursor: 'not-allowed' } : {}}
                                    >
                                      🗑️
                                    </button>
                                  )}
                                </>
                              )}
                            </div>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
              
              {/* Pagination Controls */}
              {filteredRegistrations.length > itemsPerPage && (
                <div className="pagination-controls">
                  <button
                    className="pagination-btn"
                    onClick={() => setCurrentPage(prev => Math.max(1, prev - 1))}
                    disabled={currentPage === 1}
                  >
                    ← Previous
                  </button>
                  <span className="pagination-info">
                    Page {currentPage} of {Math.ceil(filteredRegistrations.length / itemsPerPage)} 
                    (Showing {Math.min(itemsPerPage, filteredRegistrations.length - (currentPage - 1) * itemsPerPage)} of {filteredRegistrations.length} items)
                  </span>
                  <button
                    className="pagination-btn"
                    onClick={() => setCurrentPage(prev => Math.min(Math.ceil(filteredRegistrations.length / itemsPerPage), prev + 1))}
                    disabled={currentPage >= Math.ceil(filteredRegistrations.length / itemsPerPage)}
                  >
                    Next →
                  </button>
                </div>
              )}
            </>
          )}
        </div>
      </div>

      {/* Approve Modal */}
      {showApproveModal && (
        <div className="modal-overlay" onClick={() => setShowApproveModal(false)}>
          <div className="modal-content" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h2>Approve Registration</h2>
              <button 
                className="modal-close"
                onClick={() => setShowApproveModal(false)}
              >
                ×
              </button>
            </div>
            <div className="modal-body">
              <p className="modal-description">
                Select a staff member to assign this registration to:
              </p>
              <div className="modal-info">
                <div className="info-item">
                  <span className="info-label">Client:</span>
                  <span className="info-value">{selectedRegistration?.client_name}</span>
                </div>
                <div className="info-item">
                  <span className="info-label">Kebele:</span>
                  <span className="info-value">{selectedRegistration?.kebele}</span>
                </div>
                <div className="info-item">
                  <span className="info-label">Phone:</span>
                  <span className="info-value">{selectedRegistration?.client_phone}</span>
                </div>
              </div>
              <div className="form-group">
                <label htmlFor="staffSelect">
                  <span className="label-icon">👤</span>
                  Select Staff Member *
                </label>
                <select
                  id="staffSelect"
                  value={selectedStaffForApproval}
                  onChange={(e) => setSelectedStaffForApproval(e.target.value)}
                  className="modal-select"
                >
                  <option value="">-- Select Staff --</option>
                  {staffList.map(staff => (
                    <option key={staff.id} value={staff.id}>
                      {staff.username} - {staff.full_name || 'N/A'} - {staff.phone || 'No Phone'}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            <div className="modal-footer">
              <button 
                className="btn-cancel"
                onClick={() => setShowApproveModal(false)}
              >
                Cancel
              </button>
              <button 
                className="btn-approve-submit"
                onClick={handleApproveSubmit}
              >
                <span className="btn-icon">✓</span>
                Approve
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Edit Modal */}
      {showEditModal && (
        <div className="modal-overlay" onClick={handleCloseEditModal}>
          <div className="modal-content" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h2>Edit Registration</h2>
              <button className="modal-close" onClick={handleCloseEditModal}>✕</button>
            </div>
            
            <form onSubmit={handleUpdateRegistration} className="edit-form">
              <div className="form-grid">
                <div className="form-group">
                  <label htmlFor="work_type">Work Type *</label>
                  <select
                    id="work_type"
                    name="work_type"
                    value={editFormData.work_type}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="redsea-ebc">1. REDSEA with EBC Work</option>
                    <option value="sells-product">2. Sells Product Work</option>
                    <option value="other">3. Other</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="staff_id">Assigned Staff *</label>
                  <select
                    id="staff_id"
                    name="staff_id"
                    value={editFormData.staff_id || (editFormData.staff_username === 'UNAPPROVED STAFF' ? 'unapproved' : editFormData.staff_username === 'Other' ? 'other' : editFormData.staff_username === 'All' ? 'all' : '')}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="">-- Select Staff --</option>
                    <option value="unapproved">UNAPPROVED STAFF</option>
                    {staffList.map(staff => (
                      <option key={staff.id} value={staff.id}>
                        {staff.username} - {staff.full_name || 'N/A'} - {staff.phone || 'No Phone'}
                      </option>
                    ))}
                    <option value="other">Other</option>
                    <option value="all">All</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="client_name">Client Name *</label>
                  <input
                    type="text"
                    id="client_name"
                    name="client_name"
                    value={editFormData.client_name}
                    onChange={handleEditInputChange}
                    required
                  />
                </div>

                <div className="form-group">
                  <label htmlFor="kebele">Kebele *</label>
                  <select
                    id="kebele"
                    name="kebele"
                    value={editFormData.kebele}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="">-- Select Kebele --</option>
                    <option value="All Woreda">All Woreda</option>
                    {[...Array(19)].map((_, i) => (
                      <option key={i + 1} value={String(i + 1).padStart(2, '0')}>
                        {String(i + 1).padStart(2, '0')}
                      </option>
                    ))}
                    <option value="Sofi GM">Sofi GM</option>
                    <option value="Dire T GM">Dire T GM</option>
                    <option value="Erorr">Erorr</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="house_no">House No</label>
                  <input
                    type="text"
                    id="house_no"
                    name="house_no"
                    value={editFormData.house_no}
                    onChange={handleEditInputChange}
                  />
                </div>

                <div className="form-group">
                  <label htmlFor="client_phone">Client Phone *</label>
                  <input
                    type="tel"
                    id="client_phone"
                    name="client_phone"
                    value={editFormData.client_phone}
                    onChange={handleEditInputChange}
                    required
                  />
                </div>

                <div className="form-group">
                  <label htmlFor="tv_no">TV No *</label>
                  <select
                    id="tv_no"
                    name="tv_no"
                    value={editFormData.tv_no}
                    onChange={handleEditInputChange}
                    required
                  >
                    {[...Array(50)].map((_, i) => (
                      <option key={i + 1} value={i + 1}>
                        {i + 1} TV
                      </option>
                    ))}
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="person">Person *</label>
                  <select
                    id="person"
                    name="person"
                    value={editFormData.person}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="personal">Personal</option>
                    <option value="organization">Organization</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="client_email">Client Email</label>
                  <input
                    type="email"
                    id="client_email"
                    name="client_email"
                    value={editFormData.client_email}
                    onChange={handleEditInputChange}
                  />
                </div>

                <div className="form-group">
                  <label htmlFor="condition">Condition *</label>
                  <select
                    id="condition"
                    name="condition"
                    value={editFormData.condition}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="new">New</option>
                    <option value="old">Old</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="sign">Sign *</label>
                  <select
                    id="sign"
                    name="sign"
                    value={editFormData.sign}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="sign">Sign</option>
                    <option value="unsign">Unsign</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="gov_letter">Gov Letter *</label>
                  <select
                    id="gov_letter"
                    name="gov_letter"
                    value={editFormData.gov_letter}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="accept">Accept</option>
                    <option value="unaccept">Unaccept</option>
                  </select>
                </div>

                <div className="form-group">
                  <label htmlFor="paid_amount">Paid Amount</label>
                  <input
                    type="number"
                    id="paid_amount"
                    name="paid_amount"
                    value={editFormData.paid_amount}
                    onChange={handleEditInputChange}
                    min="0"
                    step="0.01"
                  />
                </div>

                <div className="form-group">
                  <label htmlFor="payment_status">Payment Status *</label>
                  <select
                    id="payment_status"
                    name="payment_status"
                    value={editFormData.payment_status}
                    onChange={handleEditInputChange}
                    required
                  >
                    <option value="unpaid">Unpaid</option>
                    <option value="paid">Paid</option>
                  </select>
                </div>
              </div>

              <div className="form-actions">
                <button type="button" className="btn-cancel" onClick={handleCloseEditModal}>
                  Cancel
                </button>
                <button type="submit" className="btn-submit">
                  <span className="btn-icon">✓</span>
                  Update Registration
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Toast Notification */}
      {notification && (
        <div className={`toast-notification ${notification.type}`}>
          <span className="toast-message">{notification.message}</span>
        </div>
      )}
    </div>
  )
}

export default NeedApproval
